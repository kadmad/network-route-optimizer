# Local settings. `make env` copies this file to .env and generates a random DJANGO_SECRET_KEY.
# Real environment variables always take precedence over .env.

# --- Django --------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-with-make-env
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (not part of this project: run your own server, version 14+) ----
# Create the database first:  createdb network_route_optimizer
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME  - change USER and PASSWORD to yours.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/network_route_optimizer

# Same database as seen from inside the Docker container (only used by `make up`).
DOCKER_DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/network_route_optimizer

# --- Rate limiting -------------------------------------------------------------
# Number of proxies in front of the API. Use 1 behind a load balancer, so the real client IP is
# rate limited instead of the balancer's.
NUM_PROXIES=0
